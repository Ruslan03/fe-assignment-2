{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@atoms/*": ["./shared/presentation/components/atoms/*"],
      "@atoms": ["./shared/presentation/components/atoms"],
      "@molecules/*": ["./shared/presentation/components/molecules/*"],
      "@molecules": ["./shared/presentation/components/molecules"],
      "@organisms/*": ["./shared/presentation/components/organisms/*"],
      "@organisms": ["./shared/presentation/components/organisms"],
      "@templates/*": ["./shared/presentation/components/templates/*"],
      "@templates": ["./shared/presentation/components/templates"],
      "@pages/*": ["./shared/presentation/components/pages/*"],
      "@pages": ["./shared/presentation/components/pages"],
      "@lib/*": ["./shared/lib/*"],
      "@lib": ["./shared/lib"],
      "@hooks/*": ["./shared/hooks/*"],
      "@hooks": ["./shared/hooks"],
      "@features/*": ["./features/*"],
      "@features": ["./features"],
      "@member/*": ["./features/member/*"],
      "@member": ["./features/member"],
      "@user/*": ["./features/user/*"],
      "@user": ["./features/user"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "vitest.config.mjs"
  ],
  "exclude": ["node_modules"]
}
